<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Profile</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

  <style>
    input:-webkit-autofill,
    textarea:-webkit-autofill {
      box-shadow: 0 0 0px 1000px #3f3f46 inset !important;
      -webkit-text-fill-color: #fff !important;
      caret-color: #fff !important;
      transition: background-color 9999s ease-in-out 0s;
    }
  </style>
</head>

<body class="min-h-screen bg-zinc-900 flex items-center justify-center p-6 text-white">
  <div class="w-full max-w-2xl bg-zinc-800 p-8 rounded-2xl shadow-lg border border-zinc-700">
    <!-- Profile Header -->
    <div class="flex flex-col items-center text-center mb-8">
      <div
        class="w-24 h-24 rounded-full bg-green-600 flex items-center justify-center text-4xl font-bold text-white mb-4 shadow-md">
        <%= user.name.charAt(0) %>
      </div>
      <h2 class="text-2xl font-semibold text-green-500">User Profile</h2>
    </div>

    <!-- Profile Details -->
    <div class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-zinc-700 pb-3">
        <span class="text-zinc-400">Full Name</span>
        <span class="font-medium text-white"><%= user.name %></span>
      </div>
      
      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-zinc-700 pb-3">
          <span class="text-zinc-400">User Name</span>
          <span class="font-medium text-white"><%= user.userName %></span>
        </div>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-zinc-700 pb-3">
        <span class="text-zinc-400">Email</span>
        <span class="font-medium text-white"><%= user.email %></span>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-zinc-700 pb-3">
        <span class="text-zinc-400">Age</span>
        <span class="font-medium text-white"><%= user.age %></span>
      </div>
    </div>

    <!-- Edit Button -->
    <div class="mt-8 text-center">
      <a href="/allPost"
        class="bg-green-600 hover:bg-green-500 transition-colors px-6 py-2 rounded-lg font-semibold shadow-md">Posts</a>
      <a href="/logout"
        class="bg-red-600 hover:bg-red-500 transition-colors px-6 py-2 rounded-lg font-semibold shadow-md">Logout</a>
    </div>
  </div>
</body>

</html>
